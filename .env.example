# Settings for the gallery server. Copy to .env and fill in; .env is git-ignored.
#
#   copy .env.example .env
#   gradlew bootRun

# Where the database file lives. SQLite: one file, no server, no credentials, and a backup is a
# copy. Fifteen phones syncing a few times a day is not a workload that needs a database process.
DB_URL=jdbc:sqlite:file:./data/gallery.db?journal_mode=WAL&busy_timeout=5000&foreign_keys=on

# The public half of the gallery signing key (keys/gallery_public_key.b64).
# The server verifies releases with it and holds no private key, so it cannot sign one itself.
GALLERY_PUBLIC_KEY=MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEfy8TvvatwGDF6sW4mSFx5DHEkzSk7hKP6Qx9cZRHX5Y1QcXOGla2V3tFACRb/DwqZkmoU04gyiH9FB5jZKmHHQ==

# Any long random string. Required to publish a release or list devices.
ADMIN_TOKEN=

# The port the phones connect to.
PORT=8080
